# Extensions (symfony, doctrine, phpunit) chargées automatiquement par phpstan/extension-installer
parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - config/reference.php
    tmpDir: var/cache/phpstan
    symfony:
        # Conteneur de test : les tests y récupèrent leurs doublures (tests/Fixtures)
        containerXmlPath: var/cache/test/App_KernelTestDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
