# Configuration d'un environnement serveur (préproduction ou production), docs/exploitation.md.
# À copier en .env.server dans le dossier de l'environnement, remplir, et ne jamais versionner : il contient les secrets.
# Lu par Docker Compose (--env-file) et transmis aux conteneurs (env_file) ; il prime sur le .env de l'image.

# —— Application ——
APP_ENV=prod
# 32 caractères aléatoires au moins : openssl rand -hex 32
APP_SECRET=
# URL publique du jeu (HTTPS, terminé par le proxy de l'hébergement)
DEFAULT_URI=https://jeu.example.org

# —— Base de données (service « database » ; ou une base gérée : adapter DATABASE_URL) ——
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://app:MOT_DE_PASSE@database:5432/app?serverVersion=18&charset=utf8

# —— Redis (verrous, cache, sessions, chat) ——
REDIS_URL=redis://redis:6379

# —— E-mails ——
MAILER_DSN=smtp://utilisateur:mot-de-passe@smtp.example.org:587
MAILER_FROM="Space Guardians <noreply@example.org>"

# —— Mercure (temps réel) : secret propre à chaque environnement, URL publique derrière le proxy ——
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=https://jeu.example.org/.well-known/mercure
MERCURE_JWT_SECRET=
MERCURE_JWT_ISSUER=https://jeu.example.org
# Préfixe __Secure- : cookie posé seulement en HTTPS
MERCURE_COOKIE_NAME=__Secure-mercure_access_token

# —— Ports publiés vers le proxy de l'hébergement ——
HTTP_PORT=8080
MERCURE_PORT=8081

# —— Sauvegardes ——
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

# —— Images (registre, déploiement automatique #93) ——
IMAGE_PREFIX=space-guardians
IMAGE_TAG=latest
