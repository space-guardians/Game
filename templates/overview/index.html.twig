{# Vue d'ensemble de la planète active (§5.4) : planète, empire, ressources ; files et alertes viendront avec les constructions. #}
{% extends 'layout/app.html.twig' %}

{% set planet_label = empire.isHomePlanet(planet) ? 'Planète mère' : 'Colonie' %}
{% set temperature = planet.temperature %}

{% block title %}Vue d’ensemble — Space Guardians{% endblock %}
{% block kicker %}{{ empire.name }} · <span class="sg-mono">{{ planet }}</span>{% endblock %}
{% block heading %}{{ planet_label }}{% endblock %}

{% block content %}
    <div class="sg-overview">
        <section class="sg-panel sg-cut-14" aria-labelledby="planet-title">
            <h2 id="planet-title" class="sg-section-title">Planète</h2>
            <dl class="sg-facts">
                <dt>Adresse</dt>
                <dd class="sg-mono">{{ planet }}</dd>
                <dt>Galaxie</dt>
                <dd>{{ planet.system.galaxy.name }}</dd>
                <dt>Système</dt>
                <dd class="sg-mono">n° {{ planet.system.number }}</dd>
                <dt>Orbite</dt>
                <dd class="sg-mono">{{ planet.position.orbit }}</dd>
                <dt>Température moyenne</dt>
                <dd class="sg-mono">{{ temperature < 0 ? '−' ~ (-temperature) : temperature }} °C</dd>
            </dl>
        </section>

        <section class="sg-panel sg-cut-14" aria-labelledby="empire-title">
            <h2 id="empire-title" class="sg-section-title">Empire</h2>
            <dl class="sg-facts">
                <dt>Nom</dt>
                <dd>{{ empire.name }}</dd>
                <dt>Orientation</dt>
                <dd><twig:Chip label="{{ empire.orientation.label }}" tone="{{ empire.orientation.value == 'aggressive' ? 'orange' : 'green' }}"/></dd>
                <dt>Score</dt>
                <dd class="sg-mono">{{ empire.score|format_number }}</dd>
                <dt>Fondé le</dt>
                <dd>{{ empire.foundedAt|format_date('long') }}</dd>
            </dl>
            <div id="protections">
                {% if newbie_until %}
                    <p class="sg-field__help"><twig:Chip label="Bouclier débutant" tone="green" dot/> Vos planètes ne peuvent être ni attaquées ni espionnées jusqu’au {{ newbie_until|date('d/m/Y H:i') }}, tant que votre score reste modeste.</p>
                {% endif %}
                <form method="post" action="{{ path('app_vacation', {operation: empire.onVacation ? 'terminer' : 'activer'}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('vacation') }}">
                    {% if empire.onVacation %}
                        <p class="sg-field__help"><twig:Chip label="Mode vacances" tone="cyan" dot/> Depuis le {{ empire.vacationSince|date('d/m/Y H:i') }} ; fin possible à partir du {{ vacation_ends_earliest|date('d/m/Y H:i') }}.</p>
                        <twig:Btn type="submit" label="Terminer le mode vacances" variant="ghost" size="sm"/>
                    {% else %}
                        <p class="sg-field__help">Mode vacances : planètes protégées, production réduite au quart, flottes à quai, au moins 48 heures.</p>
                        <twig:Btn type="submit" label="Activer le mode vacances" variant="ghost" size="sm"/>
                    {% endif %}
                </form>
            </div>
        </section>

        <section class="sg-panel sg-cut-14 sg-overview__wide" aria-labelledby="resources-title">
            <h2 id="resources-title" class="sg-section-title">Ressources</h2>
            <table class="sg-table">
                <thead>
                    <tr>
                        <th scope="col">Ressource</th>
                        <th scope="col" class="sg-num">Stock</th>
                        <th scope="col" class="sg-num">Production</th>
                        <th scope="col" class="sg-num">Capacité</th>
                    </tr>
                </thead>
                <tbody>
                    {% for kind, label in {metal: 'Métal', crystal: 'Cristal', deuterium: 'Deutérium'} %}
                        {% set amount = attribute(resources.amounts, kind) %}
                        {% set capacity = attribute(resources.capacity, kind) %}
                        <tr>
                            <th scope="row"><span class="sg-dot sg-dot--{{ kind }}" aria-hidden="true"></span>{{ label }}</th>
                            <td class="sg-num sg-mono{{ amount >= capacity ? ' is-full' }}">{{ amount|round(0, 'floor')|format_number }}</td>
                            {% set rate = attribute(resources.hourlyProduction, kind) %}
                            <td class="sg-num sg-mono">{{ rate < 0 ? '−' : '+' }}{{ rate|abs|round(0, 'floor')|format_number }}/h</td>
                            <td class="sg-num sg-mono">{{ capacity|format_number }}</td>
                        </tr>
                    {% endfor %}
                    {% set output = resources.output %}
                    <tr>
                        <th scope="row"><span class="sg-dot sg-dot--energy" aria-hidden="true"></span>Énergie</th>
                        <td class="sg-num sg-mono{{ output.energyBalance < 0 ? ' is-deficit' }}">{{ output.energyBalance < 0 ? '−' }}{{ output.energyBalance|abs|round(0, 'floor')|format_number }}</td>
                        <td class="sg-num sg-mono">{{ output.energyProduced|round(0, 'floor')|format_number }} produits</td>
                        <td class="sg-num sg-mono">{{ output.energyConsumed|round(0, 'floor')|format_number }} consommés</td>
                    </tr>
                </tbody>
            </table>
            {% if output.productionFactor < 1 %}
                <twig:AlertBanner variant="error">Énergie insuffisante : les mines ne produisent qu’à {{ (output.productionFactor * 100)|round(0, 'floor') }} % de leur capacité.</twig:AlertBanner>
            {% endif %}
            <p class="sg-field__help">Au-delà de la capacité de stockage, la production est perdue.</p>
        </section>

        <section class="sg-panel sg-cut-14 sg-overview__wide" aria-labelledby="buildings-title">
            <h2 id="buildings-title" class="sg-section-title">Bâtiments</h2>
            <table class="sg-table">
                <thead>
                    <tr>
                        <th scope="col">Bâtiment</th>
                        <th scope="col" class="sg-num">Niveau</th>
                    </tr>
                </thead>
                <tbody>
                    {% for type in building_types %}
                        <tr>
                            <th scope="row">{{ type.name }}</th>
                            <td class="sg-num sg-mono">{{ planet.buildingLevel(type) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <section class="sg-panel sg-cut-14 sg-overview__wide" aria-labelledby="queues-title">
            <h2 id="queues-title" class="sg-section-title">Files en cours</h2>
            <twig:ConstructionQueue/>
        </section>
    </div>
{% endblock %}
