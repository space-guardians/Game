{# Compte sans empire (créé avant les empires) : rien à piloter #}
{% extends 'layout/welcome.html.twig' %}

{% block title %}Passerelle — Space Guardians{% endblock %}

{% block pitch_title %}Bienvenue, Gardien.{% endblock %}
{% block pitch_text %}Ce compte n’est rattaché à aucun empire.{% endblock %}

{% block kicker %}Passerelle de commandement{% endblock %}
{% block panel_title %}Aucun empire{% endblock %}

{% block panel %}
    <p class="sg-welcome__alt">Connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>. Ce compte a été créé avant la fondation des empires : créez un nouveau compte pour jouer.</p>
    <twig:Btn href="{{ path('app_logout') }}" label="Se déconnecter" variant="ghost" icon="logout" full/>
{% endblock %}
