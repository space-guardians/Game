{# Écran « Bâtiments » (§5.4) : une carte par bâtiment, coût et durée du niveau suivant, lancement de la construction #}
{% extends 'layout/app.html.twig' %}

{% block title %}Bâtiments — Space Guardians{% endblock %}
{% block kicker %}{{ empire.name }} · <span class="sg-mono">{{ planet }}</span>{% endblock %}
{% block heading %}Bâtiments{% endblock %}

{% block content %}
    <section class="sg-panel sg-cut-14" aria-labelledby="queue-title">
        <h2 id="queue-title" class="sg-section-title">File de construction</h2>
        <twig:ConstructionQueue cancellable/>
        <p class="sg-field__help">Une seule construction à la fois par planète.</p>
    </section>

    <div class="sg-entities">
        {% for card in cards %}
            {% set type = card.type %}
            <twig:EntityCard name="{{ type.name }}" :level="card.level" state="{{ card.state }}" description="{{ type.description }}">
                <h3 class="sg-entity__meta">Niveau {{ card.level + 1 }} : {{ card.duration|duration }}</h3>
                <twig:ResourceCost :cost="card.cost" :missing="card.missing"/>
                {% if card.requires is not empty %}
                    <p class="sg-entity__meta sg-entity__requires">Requiert :
                        {% for prerequisite in card.requires %}
                            <span class="sg-mono">{{ prerequisite.required.name }} {{ prerequisite.level }}</span>{{ not loop.last ? ',' }}
                        {% endfor %}
                    </p>
                {% endif %}
                {% if card.state == 'building' %}
                    <p class="sg-entity__meta">Fin à <span class="sg-mono">{{ current.endsAt|date('H:i:s') }}</span> — voir la file de construction</p>
                {% else %}
                    <form method="post" action="{{ path('app_buildings_build', {code: type.code}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('build-' ~ type.code) }}">
                        <twig:Btn type="submit"
                            label="{{ card.state == 'locked' ? 'Verrouillé' : (current ? 'File occupée' : 'Construire niveau ' ~ (card.level + 1)) }}"
                            variant="{{ card.state == 'ready' and not current ? 'primary' : 'ghost' }}"
                            size="sm"
                            full
                            :disabled="card.state != 'ready' or current is not null"/>
                    </form>
                {% endif %}
            </twig:EntityCard>
        {% endfor %}
    </div>
{% endblock %}
