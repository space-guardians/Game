{% extends 'emails/_layout.html.twig' %}

{% block heading %}Réinitialisation de votre mot de passe{% endblock %}

{% block content %}
    <p style="margin: 0 0 24px;">Une demande de nouveau mot de passe a été faite pour votre compte. Ce lien ne sert qu’une fois et expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>
    <p style="margin: 0 0 24px;">
        <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="display: inline-block; padding: 12px 20px; background: #F2B84B; color: #1A1206; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;">Choisir un nouveau mot de passe</a>
    </p>
    <p style="margin: 0; color: #A3B1CF;">Vous n’êtes pas à l’origine de cette demande ? Ignorez cet e-mail : votre mot de passe reste inchangé.</p>
{% endblock %}
