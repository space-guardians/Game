{# Carte d'entité (charte §8) : bâtiment, vaisseau, défense ; états ready, building, short, locked.
   Le contenu (coût, actions) est passé dans le bloc « content ». #}
{% props name, state = 'ready', level = null, description = null %}
{% set states = {ready: {label: 'Disponible', tone: 'green'}, building: {label: 'En construction', tone: 'gold'}, short: {label: 'Ressources insuffisantes', tone: 'red'}, locked: {label: 'Verrouillé', tone: 'neutral'}} %}
<article {{ attributes.defaults({class: 'sg-entity sg-cut-14 sg-entity--' ~ state}) }}>
    <header class="sg-entity__header">
        <h2 class="sg-entity__name">{{ name }}</h2>
        {% if level is not null %}<span class="sg-entity__level sg-mono">Niv. {{ level }}</span>{% endif %}
    </header>
    <twig:Chip label="{{ states[state].label }}" tone="{{ states[state].tone }}" dot/>
    {% if description %}<p class="sg-entity__description">{{ description }}</p>{% endif %}
    {% block content %}{% endblock %}
</article>
