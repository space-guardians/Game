{# Barre globale (charte §8) : logo, planète active et ses ressources, empire, déconnexion #}
<header {{ attributes.defaults({class: 'sg-topbar'}) }}>
    <twig:Logo class="sg-topbar__brand"/>

    {% if this.empire %}
        {% set planet = this.empire.activePlanet %}
        <div class="sg-topbar__planet">
            <span class="sg-topbar__label">Planète active</span>
            <span class="sg-topbar__value">
                {{ this.empire.isHomePlanet(planet) ? 'Planète mère' : 'Colonie' }}
                <span class="sg-mono">{{ planet }}</span>
            </span>
        </div>

        {% set resources = this.resources %}
        <div class="sg-topbar__resources">
            {% for kind, label in {metal: 'Métal', crystal: 'Cristal', deuterium: 'Deutérium'} %}
                <twig:ResourceGauge
                    kind="{{ kind }}"
                    label="{{ label }}"
                    :amount="attribute(resources.amounts, kind)"
                    :rate="attribute(resources.hourlyProduction, kind)"
                    :capacity="attribute(resources.capacity, kind)"/>
            {% endfor %}
            {% set balance = resources.output.energyBalance %}
            <div class="sg-resource sg-resource--energy{{ balance < 0 ? ' is-deficit' }}">
                <span class="sg-resource__label">Énergie</span>
                <span class="sg-resource__amount sg-mono">{{ balance < 0 ? '−' }}{{ balance|abs|round(0, 'floor')|format_number }}</span>
                <span class="sg-resource__rate sg-mono">{{ resources.output.energyProduced|round(0, 'floor')|format_number }} produits</span>
            </div>
        </div>
    {% endif %}

    <div class="sg-topbar__account">
        {% if this.empire %}
            <span class="sg-topbar__empire">{{ this.empire.name }}</span>
        {% endif %}
        <twig:Btn href="{{ path('app_logout') }}" label="Se déconnecter" variant="ghost" size="sm" icon="logout"/>
    </div>
</header>
