        <ellipse cx="32" cy="32" rx="28" ry="9" fill="none" stroke="#6FDCEE" stroke-width="3.5" transform="rotate(-18 32 32)"/>
        <path d="M32 5L45 32L32 59L19 32Z" fill="#070B14" stroke="#F2B84B" stroke-width="4.5" stroke-linejoin="round"/>
