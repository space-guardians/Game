{# Fiche d'un joueur : champs de l'empire, suivi de la progression (ProgressCharts), puis planètes et journal d'activité (PlayerFiles) #}
{% extends '@EasyAdmin/crud/detail.html.twig' %}

{# Libellés au singulier : un événement, pas un total comme au tableau de bord #}
{% set event_labels = {'building.completed': 'Fin de construction', 'research.completed': 'Fin de recherche', 'shipyard.completed': 'Livraison du chantier spatial', 'fleet.arrival': 'Arrivée de flotte'} %}
{% set can_read_history = is_granted(constant('App\\Enum\\Admin\\AdminRole::Admin').value) %}

{% block main %}
    {{ parent() }}

    {% set user = entity.instance.user %}
    {% set token = csrf_token('moderate-' ~ entity.instance.id) %}
    <h2 class="h5 mt-4">Modération</h2>
    <section id="moderation">
        {% if user.bannedAt %}
            <p class="text-danger">Banni {{ user.banEndsAt ? 'jusqu’au ' ~ user.banEndsAt|date('d/m/Y H:i') : 'définitivement' }} : {{ user.banReason }}</p>
        {% endif %}
        {% if entity.instance.chatMutedUntil %}
            <p>Chat en sourdine jusqu’au {{ entity.instance.chatMutedUntil|date('d/m/Y H:i') }}.</p>
        {% endif %}
        <div class="row g-3">
            <form class="col-md-4" method="post" action="{{ path('admin_player_moderate', {entityId: entity.instance.id, operation: 'avertir'}) }}">
                <input type="hidden" name="_token" value="{{ token }}">
                <label class="form-label" for="avertissement">Avertissement (message du jeu)</label>
                <textarea class="form-control" id="avertissement" name="message" rows="2" required></textarea>
                <button class="btn btn-sm btn-secondary mt-1" type="submit">Avertir</button>
            </form>
            <form class="col-md-4" method="post" action="{{ path('admin_player_moderate', {entityId: entity.instance.id, operation: 'sourdine'}) }}">
                <input type="hidden" name="_token" value="{{ token }}">
                <label class="form-label" for="sourdine">Sourdine du chat (heures)</label>
                <input class="form-control" type="number" id="sourdine" name="hours" min="1" max="720" value="24">
                <button class="btn btn-sm btn-secondary mt-1" type="submit">Mettre en sourdine</button>
            </form>
            {% if user.bannedAt %}
                <form class="col-md-4" method="post" action="{{ path('admin_player_moderate', {entityId: entity.instance.id, operation: 'lever'}) }}"
                      data-controller="confirm" data-confirm-message-value="Lever le bannissement ?" data-action="confirm#ask">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <button class="btn btn-sm btn-secondary mt-4" type="submit">Lever le bannissement</button>
                </form>
            {% else %}
                <form class="col-md-4" method="post" action="{{ path('admin_player_moderate', {entityId: entity.instance.id, operation: 'bannir'}) }}"
                      data-controller="confirm" data-confirm-message-value="Bannir ce joueur ?" data-action="confirm#ask">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <label class="form-label" for="motif">Bannissement : motif et durée en jours (vide : définitif)</label>
                    <input class="form-control" type="text" id="motif" name="reason" required>
                    <input class="form-control mt-1" type="number" name="days" min="1" max="365" aria-label="Durée en jours">
                    <button class="btn btn-sm btn-danger mt-1" type="submit">Bannir</button>
                </form>
            {% endif %}
        </div>
    </section>

    <h2 class="h5 mt-4">Suivi de la progression</h2>
    <section id="progression">
        {% if progress_charts is empty %}
            <p class="text-muted">Aucun instantané sur les {{ progress_days }} derniers jours : le prochain sera pris automatiquement.</p>
        {% else %}
            <p class="text-muted">{{ progress_days }} derniers jours, comparés à la moyenne de tous les empires et à celle du top 10 du classement global au même instant.</p>
            <div class="sg-admin-progress">
                {% for title, chart in progress_charts %}
                    <figure class="sg-admin-progress__chart">
                        <figcaption class="h6">{{ title }}</figcaption>
                        {{ render_chart(chart, {'aria-label': title}) }}
                    </figure>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <h2 class="h5 mt-4">Planètes</h2>
    {% for item in player.planets %}
        {% set resources = item.resources %}
        <section class="sg-admin-player-planet" id="planete-{{ item.planet.id }}">
            <h3 class="h6">
                {{ item.planet }}
                {% if item.home %}<span class="badge badge-secondary">Planète mère</span>{% endif %}
                {% if item.planet.id == player.empire.activePlanet.id %}<span class="badge badge-info">Active</span>{% endif %}
            </h3>
            <table class="table datagrid">
                <thead>
                    <tr>
                        <th scope="col">Ressource</th>
                        <th scope="col" class="text-end">Stock</th>
                        <th scope="col" class="text-end">Capacité</th>
                        <th scope="col" class="text-end">Production / h</th>
                    </tr>
                </thead>
                <tbody>
                    {% for key, label in {metal: 'Métal', crystal: 'Cristal', deuterium: 'Deutérium'} %}
                        <tr>
                            <td>{{ label }}</td>
                            <td class="text-end">{{ attribute(resources.amounts, key)|round(0, 'floor')|format_number }}</td>
                            <td class="text-end">{{ attribute(resources.capacity, key)|round(0, 'floor')|format_number }}</td>
                            <td class="text-end">{{ attribute(resources.hourlyProduction, key)|round(0, 'floor')|format_number }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p>
                <strong>Bâtiments :</strong>
                {% for building in item.buildings %}
                    {{ building.type.name }} {{ building.level }}{{ not loop.last ? ',' }}
                {% else %}
                    aucun.
                {% endfor %}
            </p>
            <p>
                <strong>Construction en cours :</strong>
                {% if item.construction %}
                    {{ item.construction.type.name }} niveau {{ item.construction.targetLevel }}, fin le {{ item.construction.endsAt|date('d/m/Y H:i:s') }}
                {% else %}
                    aucune.
                {% endif %}
            </p>
        </section>
    {% endfor %}

    <p class="text-muted">Recherches, flottes et alliance s’ajouteront à la fiche avec leurs phases.</p>

    <h2 class="h5 mt-4">Journal d’activité</h2>
    <h3 class="h6">Actions du joueur</h3>
    <table class="table datagrid" id="actions-joueur">
        <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Opération</th>
                <th scope="col">Objet</th>
                <th scope="col">Champs</th>
            </tr>
        </thead>
        <tbody>
            {% for action in player.actions %}
                {% set entry = action.entry %}
                <tr>
                    <td>
                        {% if can_read_history %}
                            <a href="{{ path('admin_entity_history_entry', {entity: action.entity.key, id: entry.id}) }}">{{ entry.createdAt|date('d/m/Y H:i:s') }}</a>
                        {% else %}
                            {{ entry.createdAt|date('d/m/Y H:i:s') }}
                        {% endif %}
                    </td>
                    <td>{{ history_types[entry.type] ?? entry.type }}</td>
                    <td>{{ action.entity.label }} #{{ entry.objectId }}</td>
                    <td>{{ entry.type in ['insert', 'update'] ? entry.diffs|keys|filter(key => not (key starts with '@'))|join(', ') : '—' }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucune action enregistrée.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <h3 class="h6">Événements de jeu</h3>
    <table class="table datagrid" id="evenements-joueur">
        <thead>
            <tr>
                <th scope="col">Échéance</th>
                <th scope="col">Événement</th>
                <th scope="col">Planète</th>
                <th scope="col">Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for event in player.events %}
                <tr>
                    <td>{{ event.dueAt|date('d/m/Y H:i:s') }}</td>
                    <td>
                        {{ event_labels[event.type] ?? event.type }}
                        {% if event.payload.building is defined or event.payload.technology is defined %}: {{ event.payload.building ?? event.payload.technology }} niveau {{ event.payload.level ?? '?' }}{% endif %}
                        {% if event.payload.ship is defined %}: {{ event.payload.quantity ?? '?' }} × {{ event.payload.ship }}{% endif %}
                    </td>
                    <td>{{ event.planet }}</td>
                    <td><span class="badge badge-{{ event.status.badge }}">{{ event.status.label }}</span></td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucun événement.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
