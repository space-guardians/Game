{# Suivi d'une civilisation NPC (§4.14, §5.6.1) : flotte courante, statut, raids subis #}
{% extends '@EasyAdmin/page/content.html.twig' %}

{% set npc = file.empire %}
{% block page_title npc.name %}
{% block content_title npc.name ~ ' — ' ~ npc.npcProfile.category.label %}

{% block main %}
    <p><a href="{{ path('admin_npc_index') }}">Retour aux civilisations</a></p>

    <h2 class="h5 mt-3">Statut</h2>
    <ul id="statut">
        <li>Profil : {{ npc.npcProfile }} — planète mère {{ npc.homePlanet }}</li>
        <li>Points militaires (dernier classement) : {{ file.militaryPoints|number_format(0, ',', ' ') }}</li>
        {% if npc.npcProfile.category.value == 'boss' %}
            <li>Flotte recalculée : {{ npc.npcFleetRecalculatedAt ? npc.npcFleetRecalculatedAt|date('d/m/Y H:i') : 'jamais' }}{% if file.nextRecalculation %} ; prochain recalcul après le {{ file.nextRecalculation|date('d/m/Y H:i') }}{% endif %}</li>
        {% else %}
            <li>Dernier raid : {{ npc.npcLastRaidAt ? npc.npcLastRaidAt|date('d/m/Y H:i') : 'jamais' }}</li>
        {% endif %}
        {% if file.incoming is empty %}
            <li>Aucune attaque en cours.</li>
        {% else %}
            {% for attack in file.incoming %}
                <li class="text-danger">Attaquée par {{ attack.attacker.name }} : arrivée sur {{ attack.planet }} le {{ attack.arrivesAt|date('d/m/Y H:i') }}</li>
            {% endfor %}
        {% endif %}
    </ul>

    <h2 class="h5 mt-3">Planètes</h2>
    <table class="table datagrid" id="planetes">
        <thead><tr><th>Planète</th><th>Métal</th><th>Cristal</th><th>Deutérium</th></tr></thead>
        <tbody>
            {% for item in file.planets %}
                <tr>
                    <td>{{ item.planet }}</td>
                    <td>{{ item.resources.metal|number_format(0, ',', ' ') }}</td>
                    <td>{{ item.resources.crystal|number_format(0, ',', ' ') }}</td>
                    <td>{{ item.resources.deuterium|number_format(0, ',', ' ') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <h2 class="h5 mt-3">Progression</h2>
    <section id="progression">
        {% if progress_charts is empty %}
            <p class="text-muted">Aucun instantané sur les {{ progress_days }} derniers jours : le prochain sera pris automatiquement.</p>
        {% else %}
            <div class="sg-admin-progress">
                {% for title, chart in progress_charts %}
                    <figure class="sg-admin-progress__chart">
                        <figcaption class="h6">{{ title }}</figcaption>
                        {{ render_chart(chart, {'aria-label': title}) }}
                    </figure>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <h2 class="h5 mt-3">Flotte courante ({{ file.shipCount }} vaisseaux)</h2>
    <table class="table datagrid" id="flottes">
        <thead><tr><th>Flotte</th><th>État</th><th>Composition</th></tr></thead>
        <tbody>
            {% for fleet in file.fleets %}
                <tr>
                    <td>{{ fleet.name }}</td>
                    <td>{{ fleet.status.label }}</td>
                    <td>{% for code, quantity in fleet.shipCounts %}{{ quantity }} × {{ code }}{{ not loop.last ? ', ' }}{% endfor %}</td>
                </tr>
            {% else %}
                <tr><td colspan="3">Aucune flotte.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <h2 class="h5 mt-3">Raids lancés</h2>
    <table class="table datagrid" id="raids-lances">
        <thead><tr><th>Arrivée</th><th>Cible</th><th>État</th><th>Issue</th></tr></thead>
        <tbody>
            {% for battle in file.raids %}
                <tr>
                    <td>{{ battle.resolvesAt|date('d/m/Y H:i') }}</td>
                    <td>{{ battle.locationLabel }}</td>
                    <td>{{ battle.status.value == 'scheduled' ? 'En route' : (battle.status.value == 'cancelled' ? 'Annulé' : 'Résolu') }}</td>
                    <td>{{ battle.winner is null ? '—' : (battle.winner.value == 'attacker' ? 'Réussi' : 'Repoussé') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucun raid lancé.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <h2 class="h5 mt-3">Raids subis</h2>
    <table class="table datagrid" id="raids-subis">
        <thead><tr><th>Date</th><th>Lieu</th><th>Assaillant</th><th>Issue</th></tr></thead>
        <tbody>
            {% for battle in file.battles %}
                <tr>
                    <td>{{ battle.resolvedAt ? battle.resolvedAt|date('d/m/Y H:i') }}</td>
                    <td>{{ battle.locationLabel }}</td>
                    <td>{{ battle.initiator ? battle.initiator.name : '—' }}</td>
                    <td>{{ battle.winner is null ? 'Indécise' : (battle.winner.value == 'defender' ? 'Repoussé' : 'Défaite de la civilisation') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucun raid subi.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
