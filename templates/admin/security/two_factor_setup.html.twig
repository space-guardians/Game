{# Activation obligatoire de la double authentification, dans le gabarit de connexion du panneau #}
{% extends '@EasyAdmin/page/login.html.twig' %}

{% block login_form_wrapper %}
    <h1 class="h4">Activer la double authentification</h1>
    <p>Elle est obligatoire pour accéder au panneau d’administration.</p>
    <ol>
        <li>Scannez ce code avec une application d’authentification (FreeOTP, Aegis, Google Authenticator…).</li>
        <li>Saisissez le code à 6 chiffres qu’elle affiche.</li>
    </ol>

    <p class="text-center"><img src="{{ qrCode }}" width="240" height="240" alt="QR code à scanner avec l’application d’authentification"></p>
    <p class="form-text">Impossible de scanner ? Saisissez cette clé : <code class="sg-admin-secret">{{ secret }}</code></p>

    {% if setup_error %}
        <div class="w-100 alert alert-danger rounded mb-3" role="alert">{{ setup_error }}</div>
    {% endif %}

    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_2fa_setup') }}">
        <div class="form-group">
            <label class="form-control-label required" for="code">Code de vérification</label>
            <div class="form-widget">
                <input type="text" id="code" name="code" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus>
            </div>
        </div>
        <twig:ea:Button type="submit" variant="primary" size="lg" isBlock>Activer</twig:ea:Button>
    </form>

    <p class="mt-3"><a href="{{ path('admin_logout') }}">Se déconnecter</a></p>
{% endblock %}
