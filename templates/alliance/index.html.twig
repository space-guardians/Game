{# Écran « Alliance » (§4.10) : fonder ou rejoindre une alliance, puis la gérer selon son rôle #}
{% extends 'layout/app.html.twig' %}

{% block title %}Alliance — Space Guardians{% endblock %}
{% block kicker %}{{ empire.name }}{% endblock %}
{% block heading %}{{ alliance ? alliance : 'Alliance' }}{% endblock %}

{% block content %}
    {% set token = csrf_token('alliance') %}
    {% if alliance is null %}
        <section class="sg-panel sg-cut-14" aria-labelledby="invitations-title">
            <h2 id="invitations-title" class="sg-section-title">Invitations</h2>
            {% if invitations is empty %}
                <p class="sg-empty">Aucune invitation pour l’instant.</p>
            {% else %}
                <ul class="sg-alliance__list" id="invitations">
                    {% for invitation in invitations %}
                        <li>
                            <span><strong>{{ invitation.alliance }}</strong>{% if invitation.invitedBy %}, de la part de {{ invitation.invitedBy.name }}{% endif %}</span>
                            {% for decision, label in {accepter: 'Accepter', refuser: 'Refuser'} %}
                                <form method="post" action="{{ path('app_alliance_answer', {id: invitation.id, decision: decision}) }}">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <twig:Btn type="submit" label="{{ label }}" variant="{{ loop.first ? 'primary' : 'ghost' }}" size="sm"/>
                                </form>
                            {% endfor %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="sg-panel sg-cut-14" aria-labelledby="found-title">
            <h2 id="found-title" class="sg-section-title">Fonder une alliance</h2>
            <p class="sg-field__help">Les membres d’une même alliance sont alliés : ils ne peuvent pas s’attaquer, ils se renforcent et défendent ensemble, et peuvent s’envoyer des ressources.</p>
            <form method="post" action="{{ path('app_alliance_found') }}" class="sg-alliance__form" id="fonder">
                <input type="hidden" name="_token" value="{{ token }}">
                <div class="sg-field">
                    <label class="sg-field__label" for="nom-alliance">Nom</label>
                    <input class="sg-input" type="text" id="nom-alliance" name="name" required>
                </div>
                <div class="sg-field">
                    <label class="sg-field__label" for="tag-alliance">Tag (2 à 5 lettres ou chiffres)</label>
                    <input class="sg-input sg-mono" type="text" id="tag-alliance" name="tag" maxlength="5" required>
                </div>
                <div class="sg-field">
                    <label class="sg-field__label" for="description-alliance">Description</label>
                    <textarea class="sg-input" id="description-alliance" name="description" rows="3"></textarea>
                </div>
                <twig:Btn type="submit" label="Fonder" variant="primary" size="sm"/>
            </form>
        </section>
    {% else %}
        <section class="sg-panel sg-cut-14" aria-labelledby="alliance-title">
            <h2 id="alliance-title" class="sg-section-title">L’alliance</h2>
            <p class="sg-entity__meta" id="alliance">
                Fondée le {{ alliance.foundedAt|date('d/m/Y') }} · {{ alliance.members|length }} membre(s) · votre rôle : {{ member.role.label|lower }}
            </p>
            {% if alliance.description %}<p>{{ alliance.description|nl2br }}</p>{% endif %}
            <p class="sg-entity__meta" id="partage">
                Rapports de combat {{ alliance.sharesCombatReports ? 'partagés avec toute l’alliance' : 'réservés aux membres engagés' }}.
            </p>
            {% if member.role.value == 'founder' %}
                <form method="post" action="{{ path('app_alliance_share') }}">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="share" value="{{ alliance.sharesCombatReports ? '0' : '1' }}">
                    <twig:Btn type="submit" label="{{ alliance.sharesCombatReports ? 'Ne plus partager les rapports de combat' : 'Partager les rapports de combat' }}" variant="ghost" size="sm"/>
                </form>
                <form method="post" action="{{ path('app_alliance_describe') }}" class="sg-alliance__form">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <label class="sg-field__label" for="description">Description</label>
                    <textarea class="sg-input" id="description" name="description" rows="3">{{ alliance.description }}</textarea>
                    <twig:Btn type="submit" label="Enregistrer la description" variant="ghost" size="sm"/>
                </form>
            {% endif %}
        </section>

        <section class="sg-panel sg-cut-14" aria-labelledby="members-title">
            <h2 id="members-title" class="sg-section-title">Membres</h2>
            <table class="sg-table" id="membres">
                <thead>
                    <tr>
                        <th scope="col">Empire</th>
                        <th scope="col">Rôle</th>
                        <th scope="col">Depuis</th>
                        {% if member.role.value == 'founder' %}<th scope="col">Gestion</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for other in alliance.members %}
                        <tr>
                            <td>{{ other.empire.name }}{{ other is same as(member) ? ' (vous)' }}</td>
                            <td>{{ other.role.label }}</td>
                            <td class="sg-mono">{{ other.joinedAt|date('d/m/Y') }}</td>
                            {% if member.role.value == 'founder' %}
                                <td>
                                    {% if other is not same as(member) %}
                                        <div class="sg-alliance__actions">
                                            {% for role in roles|filter(role => role != other.role) %}
                                                <form method="post" action="{{ path('app_alliance_manage', {id: other.id, operation: 'role'}) }}">
                                                    <input type="hidden" name="_token" value="{{ token }}">
                                                    <input type="hidden" name="role" value="{{ role.value }}">
                                                    <twig:Btn type="submit" label="{{ role.value == 'diplomat' ? 'Nommer diplomate' : 'Rétrograder' }}" variant="ghost" size="sm"/>
                                                </form>
                                            {% endfor %}
                                            <form method="post" action="{{ path('app_alliance_manage', {id: other.id, operation: 'fondateur'}) }}">
                                                <input type="hidden" name="_token" value="{{ token }}">
                                                <twig:Btn type="submit" label="Transmettre la fondation" variant="ghost" size="sm"/>
                                            </form>
                                            <form method="post" action="{{ path('app_alliance_manage', {id: other.id, operation: 'exclure'}) }}">
                                                <input type="hidden" name="_token" value="{{ token }}">
                                                <twig:Btn type="submit" label="Exclure" variant="danger" size="sm"/>
                                            </form>
                                        </div>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <section class="sg-panel sg-cut-14" aria-labelledby="alliance-planet-title" id="planete-alliance">
            <h2 id="alliance-planet-title" class="sg-section-title">Planète d’alliance</h2>
            {% if alliance_planet is null %}
                <p class="sg-field__help">
                    Une planète artificielle, propriété de toute l’alliance : les membres l’alimentent par transport, elle abrite les
                    bâtiments uniques et se défend avec ses propres défenses. Construction sur une orbite libre, en {{ alliance_planet_hours }} h,
                    pour {{ alliance_planet_cost.metal|number_format(0, ',', ' ') }} métal, {{ alliance_planet_cost.crystal|number_format(0, ',', ' ') }} cristal
                    et {{ alliance_planet_cost.deuterium|number_format(0, ',', ' ') }} deutérium pris sur la planète active du fondateur.
                </p>
                {% if member.role.value == 'founder' %}
                    <form method="post" action="{{ path('app_alliance_planet_build') }}" class="sg-alliance__form" id="construire-planete">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <label class="sg-field__label" for="planete-nom">Nom</label>
                        <input class="sg-input" type="text" id="planete-nom" name="name" maxlength="40" required>
                        <label class="sg-field__label" for="planete-galaxie">Galaxie</label>
                        <input class="sg-input sg-mono" type="number" id="planete-galaxie" name="galaxy" min="1" value="{{ planet.system.galaxy.number }}" required>
                        <label class="sg-field__label" for="planete-systeme">Système</label>
                        <input class="sg-input sg-mono" type="number" id="planete-systeme" name="system" min="1" value="{{ planet.system.number }}" required>
                        <label class="sg-field__label" for="planete-orbite">Orbite</label>
                        <input class="sg-input sg-mono" type="number" id="planete-orbite" name="orbit" min="1" max="15" required>
                        <twig:Btn type="submit" label="Construire la planète" variant="primary" size="sm"/>
                    </form>
                {% endif %}
            {% else %}
                {% set manager = member.role.canRecruit %}
                {% set built = alliance_planet.builtAt(now) %}
                <p class="sg-entity__meta" id="planete">
                    <strong>{{ alliance_planet.name }}</strong> · <span class="sg-mono">{{ alliance_planet.planet }}</span> ·
                    {% if built %}intégrité {{ alliance_planet.integrity }} %{% else %}en construction jusqu’au <span class="sg-mono">{{ alliance_planet.completesAt|date('d/m/Y H:i') }}</span>{% endif %}
                </p>
                <p class="sg-entity__meta" id="planete-stock">
                    Stock : {{ alliance_stock.metal|round(0, 'floor')|number_format(0, ',', ' ') }} métal ·
                    {{ alliance_stock.crystal|round(0, 'floor')|number_format(0, ',', ' ') }} cristal ·
                    {{ alliance_stock.deuterium|round(0, 'floor')|number_format(0, ',', ' ') }} deutérium — alimenté par les transports des membres.
                </p>
                {% if built %}
                    <table class="sg-table" id="batiments-alliance">
                        <thead>
                            <tr>
                                <th scope="col">Bâtiment unique</th>
                                <th scope="col">Niveau</th>
                                <th scope="col">Niveau suivant</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for type in alliance_building_types %}
                                {% set level = alliance_planet.buildingLevel(type) %}
                                {% set cost = type.cost(level + 1) %}
                                <tr>
                                    <td><strong>{{ type.label }}</strong><br><span class="sg-field__help">{{ type.description }}</span></td>
                                    <td class="sg-mono">{{ level }}</td>
                                    <td>
                                        <span class="sg-mono">{{ cost.metal|number_format(0, ',', ' ') }} / {{ cost.crystal|number_format(0, ',', ' ') }} / {{ cost.deuterium|number_format(0, ',', ' ') }}</span>
                                        {% if manager %}
                                            <form method="post" action="{{ path('app_alliance_planet_raise', {type: type.value}) }}">
                                                <input type="hidden" name="_token" value="{{ token }}">
                                                <twig:Btn type="submit" label="{{ level == 0 ? 'Construire' : 'Améliorer' }}" variant="ghost" size="sm"/>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>

                    <h3 class="sg-section-title">Scanner</h3>
                    {% if scan_range <= 0 %}
                        <p class="sg-empty">Pas de scanner : construisez-le pour repérer les flottes des autres empires autour de la planète.</p>
                    {% else %}
                        <p class="sg-field__help">Portée {{ scan_range|number_format(0, ',', ' ') }} : flottes des autres empires à l’arrêt ou en vol. Tout départ dont le trajet passe à portée alerte aussitôt les membres.</p>
                        {% if scan_contacts is empty %}
                            <p class="sg-empty" id="scanner">Aucune flotte à portée.</p>
                        {% else %}
                            <table class="sg-table" id="scanner">
                                <thead>
                                    <tr>
                                        <th scope="col">Empire</th>
                                        <th scope="col">Flotte</th>
                                        <th scope="col">Vaisseaux</th>
                                        <th scope="col">Distance</th>
                                        <th scope="col">Mouvement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for contact in scan_contacts %}
                                        <tr>
                                            <td>{{ contact.empire }}</td>
                                            <td>{{ contact.fleet }}</td>
                                            <td class="sg-mono">{{ contact.ships }}</td>
                                            <td class="sg-mono">{{ contact.distance|number_format(0, ',', ' ') }}</td>
                                            <td>
                                                {% if contact.inFlight %}
                                                    vers {{ contact.destination }}, arrivée <span class="sg-mono">{{ contact.arrivesAt|date('d/m H:i') }}</span>
                                                {% else %}
                                                    à l’arrêt
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% endif %}
                    {% endif %}

                    <h3 class="sg-section-title">Défenses</h3>
                    {% set stocked = alliance_planet.planet.ships|filter(stock => stock.type.defense and stock.quantity > 0) %}
                    {% if stocked is empty %}
                        <p class="sg-empty">Aucune défense.</p>
                    {% else %}
                        <p class="sg-entity__meta" id="defenses-alliance">{{ stocked|map(stock => stock.quantity ~ ' × ' ~ stock.type.name)|join(' · ') }}</p>
                    {% endif %}
                    {% if alliance_orders is not empty %}
                        <p class="sg-entity__meta" id="commandes-alliance">En construction : {{ alliance_orders|map(order => order.quantity ~ ' × ' ~ order.type.name ~ ' (' ~ order.endsAt|date('d/m H:i') ~ ')')|join(' · ') }}</p>
                    {% endif %}
                    {% if manager and defense_types is not empty %}
                        <form method="post" action="{{ path('app_alliance_planet_defenses') }}" class="sg-alliance__form" id="commander-defenses">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <label class="sg-field__label" for="defense-type">Défense</label>
                            <select class="sg-input" id="defense-type" name="type">
                                {% for type in defense_types %}
                                    <option value="{{ type.code }}">{{ type.name }}</option>
                                {% endfor %}
                            </select>
                            <label class="sg-field__label" for="defense-quantite">Quantité</label>
                            <input class="sg-input sg-mono" type="number" id="defense-quantite" name="quantity" min="1" value="1" required>
                            <twig:Btn type="submit" label="Commander" variant="primary" size="sm"/>
                        </form>
                    {% endif %}
                {% endif %}
            {% endif %}
        </section>

        {% if member.role.canRecruit %}
            <section class="sg-panel sg-cut-14" aria-labelledby="recruit-title">
                <h2 id="recruit-title" class="sg-section-title">Recrutement</h2>
                <form method="post" action="{{ path('app_alliance_invite') }}" class="sg-alliance__form">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <label class="sg-field__label" for="invite">Inviter un empire</label>
                    <input class="sg-input" type="text" id="invite" name="name" placeholder="Nom de l’empire" required>
                    <twig:Btn type="submit" label="Inviter" variant="primary" size="sm"/>
                </form>
                {% if pending is not empty %}
                    <p class="sg-entity__meta" id="invitations-envoyees">En attente : {{ pending|map(invitation => invitation.empire.name)|join(', ') }}</p>
                {% endif %}
            </section>
        {% endif %}

        <section class="sg-panel sg-cut-14" aria-labelledby="leave-title">
            <h2 id="leave-title" class="sg-section-title">Quitter</h2>
            <div class="sg-alliance__actions">
                <form method="post" action="{{ path('app_alliance_leave') }}">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <twig:Btn type="submit" label="Quitter l’alliance" variant="ghost" size="sm"/>
                </form>
                {% if member.role.value == 'founder' %}
                    <form method="post" action="{{ path('app_alliance_dissolve') }}">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <twig:Btn type="submit" label="Dissoudre l’alliance" variant="danger" size="sm"/>
                    </form>
                {% endif %}
            </div>
        </section>
    {% endif %}

    <section class="sg-panel sg-cut-14" aria-labelledby="pacts-title">
        <h2 id="pacts-title" class="sg-section-title">Pactes de non-agression</h2>
        <p class="sg-field__help">
            Un pacte lie deux empires pour une durée négociée (au plus {{ max_pact_days }} jours) : ils ne peuvent pas s’attaquer et
            peuvent se ravitailler. Une fois conclu, il ne se rompt pas avant son terme.
        </p>
        {% if pacts is not empty %}
            <ul class="sg-alliance__list" id="pactes">
                {% for pact in pacts %}
                    <li>
                        <span>
                            <strong>{{ pact.counterpart(empire).name }}</strong> ·
                            {% if pact.concluded %}
                                en vigueur jusqu’au <span class="sg-mono">{{ pact.endsAt|date('d/m/Y H:i') }}</span>
                            {% else %}
                                {{ pact.proposer is same as(empire) ? 'proposé' : 'vous propose' }} un pacte de {{ pact.days }} jours
                            {% endif %}
                        </span>
                        {% if not pact.concluded %}
                            {% if pact.partner is same as(empire) %}
                                <form method="post" action="{{ path('app_alliance_pact_answer', {id: pact.id, decision: 'accepter'}) }}">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <twig:Btn type="submit" label="Conclure le pacte" variant="primary" size="sm"/>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ path('app_alliance_pact_answer', {id: pact.id, decision: 'refuser'}) }}">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <twig:Btn type="submit" label="{{ pact.proposer is same as(empire) ? 'Retirer la proposition' : 'Refuser' }}" variant="ghost" size="sm"/>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <form method="post" action="{{ path('app_alliance_pact_propose') }}" class="sg-alliance__form" id="proposer-pacte">
            <input type="hidden" name="_token" value="{{ token }}">
            <label class="sg-field__label" for="pacte-empire">Proposer un pacte à</label>
            <input class="sg-input" type="text" id="pacte-empire" name="name" placeholder="Nom de l’empire" required>
            <label class="sg-field__label" for="pacte-duree">Durée (jours)</label>
            <input class="sg-input sg-mono" type="number" id="pacte-duree" name="days" min="1" max="{{ max_pact_days }}" value="30" required>
            <twig:Btn type="submit" label="Proposer le pacte" variant="primary" size="sm"/>
        </form>
    </section>
{% endblock %}
