{# Écran « Flotte » (§4.5) : hangar de la planète active, constitution d'une flotte, flottes de l'empire #}
{% extends 'layout/app.html.twig' %}

{% block title %}Flotte — Space Guardians{% endblock %}
{% block kicker %}{{ empire.name }} · <span class="sg-mono">{{ planet }}</span>{% endblock %}
{% block heading %}Flotte{% endblock %}

{% block content %}
    <section class="sg-panel sg-cut-14" aria-labelledby="hangar-title">
        <h2 id="hangar-title" class="sg-section-title">Hangar de la planète</h2>
        {% if hangar is empty %}
            <p class="sg-empty">Aucun vaisseau en attente sur cette planète. <a href="{{ path('app_shipyard') }}">Commander des vaisseaux au chantier spatial</a></p>
        {% else %}
            <form method="post" action="{{ path('app_fleet_assemble') }}" class="sg-fleet-form">
                <input type="hidden" name="_token" value="{{ csrf_token('assemble-fleet') }}">
                <table class="sg-table" id="hangar">
                    <thead>
                        <tr>
                            <th scope="col">Vaisseau</th>
                            <th scope="col">Classe</th>
                            <th scope="col" class="sg-num">Au hangar</th>
                            <th scope="col" class="sg-num">Dans la flotte</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in hangar %}
                            {% set type = row.type %}
                            <tr>
                                <td><label for="flotte-{{ type.code }}">{{ type.name }}</label></td>
                                <td>{{ type.shipClass.name ?? type.category.label }}</td>
                                <td class="sg-num sg-mono">{{ row.count|format_number }}</td>
                                <td class="sg-num">
                                    <input class="sg-input sg-mono" type="number" id="flotte-{{ type.code }}" name="ships[{{ type.code }}]" min="0" max="{{ row.count }}" placeholder="0">
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div class="sg-fleet-form__footer">
                    <div class="sg-field">
                        <label class="sg-field__label" for="nom-flotte">Nom de la flotte</label>
                        <input class="sg-input" type="text" id="nom-flotte" name="name" maxlength="{{ name_max_length }}" placeholder="Flotte {{ fleets|length + 1 }}">
                    </div>
                    <twig:Btn type="submit" label="Constituer la flotte" variant="primary" size="sm"/>
                </div>
                <p class="sg-field__help">Les vaisseaux choisis quittent le hangar pour former une flotte stationnée sur cette planète.</p>
            </form>
        {% endif %}
    </section>

    <section class="sg-panel sg-cut-14" aria-labelledby="fleets-title">
        <h2 id="fleets-title" class="sg-section-title">Flottes de l’empire</h2>
        {% if fleets is empty %}
            <p class="sg-empty">Aucune flotte constituée.</p>
        {% else %}
            <ul class="sg-fleets" id="flottes">
                {% for fleet in fleets %}
                    {% set movement = movements[fleet.id] ?? null %}
                    {% set last_done = fleet.orders|filter(order => order.status.value == 'done')|last %}
                    <li class="sg-fleet sg-cut-10" id="flotte-{{ fleet.id }}">
                        <header class="sg-fleet__header">
                            <h3 class="sg-fleet__name">{{ fleet.name }}</h3>
                            <twig:Chip label="{{ fleet.status.label }}" tone="{{ fleet.status.tone }}" dot/>
                        </header>
                        {% if movement %}
                            <div class="sg-fleet__movement"
                                data-controller="countdown"
                                data-countdown-start-value="{{ movement.departedAt.timestamp * 1000 }}"
                                data-countdown-end-value="{{ movement.arrivesAt.timestamp * 1000 }}"
                                data-countdown-server-now-value="{{ now.format('Uv') }}">
                                <p class="sg-entity__meta">
                                    {{ movement.order.action.label }} vers <span class="sg-mono">{{ movement.order.destinationLabel }}</span>
                                    · arrivée à <span class="sg-mono">{{ movement.arrivesAt|date('H:i:s') }}</span>
                                    (<span class="sg-mono" data-countdown-target="remaining">{{ max(0, movement.arrivesAt.timestamp - now.timestamp)|duration }}</span>)
                                </p>
                                <div class="sg-queue-item__progress" role="progressbar" aria-label="Avancement du trajet" aria-valuemin="0" aria-valuemax="100">
                                    <span data-countdown-target="bar"></span>
                                </div>
                            </div>
                        {% else %}
                            <p class="sg-entity__meta">
                                Stationnée en <span class="sg-mono">{{ fleet.planet ? fleet.planet.address : (last_done ? last_done.destinationLabel : '—') }}</span>
                            </p>
                        {% endif %}
                        <p class="sg-entity__meta">
                            {{ fleet.shipCount|format_number }} vaisseau(x)
                            · Cargo <span class="sg-mono">{{ fleet.cargo|format_number }}</span>
                            · Vitesse <span class="sg-mono">{{ fleet.slowestSpeed|format_number }}</span>
                        </p>
                        <p class="sg-fleet__ships">
                            {% for ships in fleet.ships %}
                                <span class="sg-mono">{{ ships.quantity|format_number }} × {{ ships.type.name }}</span>{{ not loop.last ? ',' }}
                            {% endfor %}
                        </p>
                        {% set loaded = fleet.getCargo() %}
                        {% if loaded.metal + loaded.crystal + loaded.deuterium > 0 %}
                            <p class="sg-entity__meta">À bord : <twig:ResourceCost :cost="loaded"/></p>
                        {% endif %}
                        {% if fleet.orders is not empty %}
                            <ol class="sg-fleet__orders">
                                {% for order in fleet.orders %}
                                    <li class="sg-fleet__order sg-fleet__order--{{ order.status.value }}">
                                        {{ order.action.label }} → <span class="sg-mono">{{ order.destinationLabel }}</span>
                                        <span class="sg-fleet__order-status">{{ order.status.label }}</span>
                                        {% if order.failure %}<span class="sg-field__help">{{ order.failure }}</span>{% endif %}
                                    </li>
                                {% endfor %}
                            </ol>
                        {% endif %}
                        <div class="sg-fleet__actions">
                            {% if fleet.stationed %}
                                <twig:Btn label="Envoyer" href="{{ path('app_fleet_dispatch', {id: fleet.id}) }}" size="sm"/>
                            {% endif %}
                            <twig:Btn label="Formation" href="{{ path('app_fleet_formation', {id: fleet.id}) }}" variant="ghost" size="sm"/>
                            {% if fleet.atHome %}
                                <form method="post" action="{{ path('app_fleet_disband', {id: fleet.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('disband-fleet-' ~ fleet.id) }}">
                                    <twig:Btn type="submit" label="Dissoudre" variant="ghost" size="sm"/>
                                </form>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <p class="sg-field__help">Une flotte exécute son carnet d’ordres l’un après l’autre, puis reste stationnée là où elle est. Dissoudre une flotte stationnée sur une planète de l’empire rend ses vaisseaux et sa cargaison à cette planète.</p>
    </section>
{% endblock %}
