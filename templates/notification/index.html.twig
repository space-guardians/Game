{# Écran « Notifications » (§4.12.3) : historique, les plus récentes d'abord ; tout est marqué lu à l'affichage #}
{% extends 'layout/app.html.twig' %}

{% block title %}Notifications — Space Guardians{% endblock %}
{% block kicker %}{{ empire.name }}{% endblock %}
{% block heading %}Notifications{% endblock %}

{% block content %}
    <section class="sg-panel sg-cut-14" aria-labelledby="notifications-title">
        <h2 id="notifications-title" class="sg-section-title">Historique</h2>
        <p class="sg-field__help">Fins de construction, arrivées de flotte, attaques entrantes et nouveaux messages. Les nouvelles notifications s’ajoutent ici en direct.</p>
        {% if notifications is empty %}
            <p class="sg-empty">Aucune notification pour l’instant.</p>
        {% endif %}
        <ul class="sg-conversations" id="notifications-list">
            {% for notification in notifications %}
                {{ include('notification/_item.html.twig', {notification: notification}) }}
            {% endfor %}
        </ul>
        {% if page > 1 or has_next %}
            <nav class="sg-messaging__tabs" aria-label="Pages">
                {% if page > 1 %}<a href="{{ path('app_notifications', {page: page - 1}) }}">Plus récentes</a>{% endif %}
                {% if has_next %}<a href="{{ path('app_notifications', {page: page + 1}) }}">Plus anciennes</a>{% endif %}
            </nav>
        {% endif %}
    </section>
{% endblock %}
