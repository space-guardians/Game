{% extends 'layout/welcome.html.twig' %}

{% block title %}Connexion — Space Guardians{% endblock %}

{% block pitch_title %}Votre empire a continué sans vous.{% endblock %}
{% block pitch_text %}Production, constructions et flottes ont avancé pendant votre absence. Reprenez le commandement.{% endblock %}
{% block pitch_extra %}
    <div class="sg-welcome__chips">
        <twig:Chip label="Univers en ligne" tone="green" dot/>
    </div>
{% endblock %}

{% block kicker %}Passerelle de commandement{% endblock %}
{% block panel_title %}Connexion{% endblock %}

{% block panel %}
    {% if error %}
        <twig:AlertBanner variant="error">{{ error.messageKey|trans(error.messageData, 'security') }}</twig:AlertBanner>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}" class="sg-form">
        <div class="sg-fields">
            <div class="sg-field{{ error ? ' sg-field--error' }}">
                <label class="sg-field__label" for="email">Adresse e-mail</label>
                <input class="sg-input" type="email" id="email" name="email" value="{{ last_username }}" placeholder="vous@exemple.fr" autocomplete="username" required autofocus>
            </div>
            <div class="sg-field{{ error ? ' sg-field--error' }}">
                <span class="sg-field__label">
                    <label for="password">Mot de passe</label>
                    <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
                </span>
                <input class="sg-input" type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
        </div>

        <label class="sg-check" for="remember_me">
            <input type="checkbox" id="remember_me" name="_remember_me">
            <span>Rester connecté sur cet appareil</span>
        </label>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <twig:Btn type="submit" label="Reprendre le commandement" icon="arrow" full/>
    </form>

    <div class="sg-divider">Nouveau Gardien ?</div>
    <twig:Btn href="{{ path('app_register') }}" label="Fonder un empire" variant="ghost" full/>

    <twig:AlertBanner variant="info">Un seul compte par joueur. Les connexions multiples depuis un même appareil sont surveillées.</twig:AlertBanner>
{% endblock %}
