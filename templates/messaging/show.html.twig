{# Conversation ouverte (§4.12.2) : messages vus par ce participant, réponse, participants, archivage, suppression #}
{% extends 'layout/app.html.twig' %}

{% block title %}{{ conversation.titleFor(empire) }} — Space Guardians{% endblock %}
{% block kicker %}{{ empire.name }} · Messagerie{% endblock %}
{% block heading %}{{ conversation.titleFor(empire) }}{% endblock %}

{% block content %}
    <section class="sg-panel sg-cut-14" aria-labelledby="participants-title">
        <h2 id="participants-title" class="sg-section-title">{{ conversation.group ? 'Groupe' : 'Conversation à deux' }}</h2>
        <p class="sg-entity__meta" id="participants">
            {% for participant in conversation.participants %}
                {{ participant.empire is same as(empire) ? 'Vous' : participant.empire.name }}{% if not participant.active %} (parti){% endif %}{{ not loop.last ? ',' }}
            {% endfor %}
        </p>
        <div class="sg-messaging__actions">
            <form method="post" action="{{ path('app_messaging_archive', {id: conversation.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('messaging-archive-' ~ conversation.id) }}">
                <twig:Btn type="submit" label="{{ place.archived ? 'Désarchiver' : 'Archiver' }}" variant="ghost" size="sm"/>
            </form>
            <form method="post" action="{{ path('app_messaging_clear', {id: conversation.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('messaging-clear-' ~ conversation.id) }}">
                <twig:Btn type="submit" label="Supprimer de mon côté" variant="ghost" size="sm"/>
            </form>
            {% if conversation.group and place.active %}
                <form method="post" action="{{ path('app_messaging_leave', {id: conversation.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('messaging-leave-' ~ conversation.id) }}">
                    <twig:Btn type="submit" label="Quitter le groupe" variant="ghost" size="sm"/>
                </form>
            {% endif %}
        </div>
        {% if conversation.group and place.active %}
            <form method="post" action="{{ path('app_messaging_add', {id: conversation.id}) }}" class="sg-messaging__add">
                <input type="hidden" name="_token" value="{{ csrf_token('messaging-add-' ~ conversation.id) }}">
                <label class="sg-field__label" for="ajout">Ajouter des participants</label>
                <input class="sg-input" type="text" id="ajout" name="names" placeholder="Noms d’empires, séparés par des virgules">
                <twig:Btn type="submit" label="Ajouter" variant="ghost" size="sm"/>
            </form>
        {% endif %}
    </section>

    <section class="sg-panel sg-cut-14" aria-labelledby="messages-title">
        <h2 id="messages-title" class="sg-section-title">Messages</h2>
        <ol class="sg-messages" id="conversation-{{ conversation.id }}-messages">
            {% for message in messages %}
                {{ include('messaging/_message.html.twig', {message: message, viewer: empire}) }}
            {% endfor %}
        </ol>
        <span id="dernier"></span>
        {% if place.active %}
            <twig:MessageComposer :conversationId="conversation.id"/>
        {% else %}
            <p class="sg-empty">Vous avez quitté cette conversation : vous ne pouvez plus y répondre.</p>
        {% endif %}
        <a href="{{ path('app_messaging') }}">Retour aux conversations</a>
    </section>
{% endblock %}
