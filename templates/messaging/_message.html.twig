{# Un message, vu par un participant (« vous » pour ses propres messages) ; signalable à l'affichage de la conversation (« reportable »), pas dans les messages poussés en direct #}
<li class="sg-message{{ message.author is same as(viewer) ? ' sg-message--mine' }}" id="message-{{ message.id }}">
    <p class="sg-entity__meta">
        <strong>{{ message.author is null ? 'Message du jeu' : (message.author is same as(viewer) ? 'Vous' : message.author.name) }}</strong>
        · <span class="sg-mono">{{ message.sentAt|date('d/m H:i') }}</span>
    </p>
    <p class="sg-message__body">{{ message.body|nl2br }}</p>
    {% if reportable|default(false) and message.author is not null and message.author is not same as(viewer) %}
        <details class="sg-message__report">
            <summary>Signaler</summary>
            <form method="post" action="{{ path('app_messaging_report', {id: message.id}) }}" data-turbo-frame="_top">
                <input type="hidden" name="_token" value="{{ csrf_token('report-message-' ~ message.id) }}">
                <label class="sg-field__label" for="motif-{{ message.id }}">Motif du signalement</label>
                <textarea class="sg-input" id="motif-{{ message.id }}" name="reason" rows="2" maxlength="500" required></textarea>
                <twig:Btn type="submit" label="Signaler à la modération" variant="ghost" size="sm"/>
            </form>
        </details>
    {% endif %}
    {% if message.link %}
        <p><a href="{{ message.link }}" data-turbo-frame="_top">Voir le détail</a></p>
    {% endif %}
</li>
